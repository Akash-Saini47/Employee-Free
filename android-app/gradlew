#!/bin/sh
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_VERSION=8.9
if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi
CACHE_DIR="${GRADLE_USER_HOME:-$HOME/.gradle}/salarywise-wrapper/gradle-$GRADLE_VERSION"
GRADLE_BIN="$CACHE_DIR/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
  DIST="$CACHE_DIR/gradle.zip"
  mkdir -p "$CACHE_DIR"
  if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 3 "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -o "$DIST"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$DIST" "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
  else
    echo "Gradle is not installed and curl/wget is unavailable." >&2
    exit 1
  fi
  rm -rf "$CACHE_DIR/unpacked"
  mkdir -p "$CACHE_DIR/unpacked"
  unzip -q "$DIST" -d "$CACHE_DIR/unpacked"
  mv "$CACHE_DIR/unpacked/gradle-$GRADLE_VERSION"/* "$CACHE_DIR/"
  rm -rf "$CACHE_DIR/unpacked" "$DIST"
fi
exec "$GRADLE_BIN" "$@"
